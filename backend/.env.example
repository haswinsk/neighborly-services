NODE_ENV=development
PORT=5000

# Database - Prisma expects DATABASE_URL
DATABASE_URL=mongodb://127.0.0.1:27017/neighborly_services

# Auth - must be at least 32 characters in production
JWT_SECRET=change_this_secret_to_a_long_secure_random_string

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
# Production: set CLIENT_URL=https://neighborly-services.vercel.app

# Admin commission rate (percentage)
ADMIN_COMMISSION_RATE=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=30
